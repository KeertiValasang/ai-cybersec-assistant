# Secrets -- never commit these
.env
*.env

# Python
__pycache__/
*.pyc
venv/
*.egg-info/

# Data (large files -- document how to get them in README instead)
data/raw/*.parquet
data/raw/*.csv
data/processed/*.parquet
data/processed/*.pkl
data/processed/*.csv

# Trained models (large binary files)
models/*.pkl

# Generated knowledge base vector store
knowledge_base/chroma_db/

# Generated reports
reports/*.md

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
*.log

# Keep folder structure even though contents are ignored
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!knowledge_base/.gitkeep
